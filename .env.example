# Local development writes here. Docker overrides this with /data/atlas.db.
DATABASE_PATH=./data/atlas.db

# Required in production. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me

APP_ORIGIN=https://your-atlas-host.example

# WebAuthn/passkeys must use the final HTTPS origin and hostname in production.
WEBAUTHN_ORIGIN=https://your-atlas-host.example
WEBAUTHN_RP_ID=your-atlas-host.example

# Google OpenID Connect. Create a Web application OAuth client and keep its
# secret only in the ignored deployment .env. Atlas requests `openid email`;
# it never requests Gmail access or stores Google tokens.
GOOGLE_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-web-client-secret

# Exact, server-side Google email allowlist entry for Edward. Lisa uses an
# Atlas password that Edward configures in Settings; no password belongs here.
# Use the real approved Edward address only in the ignored deployment .env.
ATLAS_EDWARD_EMAIL=approved-edward@example.com

# Used only with docker-compose.npm.yml when a shared reverse-proxy network is used.
NPM_NETWORK=your-reverse-proxy-network
